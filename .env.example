# Cerebras Cloud API key — https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk-...

# Optional: override default model (llama-3.3-70b)
# CEREBRAS_MODEL=llama-3.3-70b

# Server port (default 3000)
# PORT=3000

# GitHub PAT for live github.* tools and query prefetch (repo scope enough for public data)
# GITHUB_TOKEN=ghp_...

# Optional OpenClaw Gateway (POST {OPENCLAW_URL}/tools/invoke)
# If unset, PearlEye runs local tool plugins in-process.
# OPENCLAW_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=
