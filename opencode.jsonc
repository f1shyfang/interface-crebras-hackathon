{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1"
      },
      "models": {
        "moonshotai-kimi-k3.1-pro-trial": {
          "name": "Kimi K3.1 Pro (Trial)",
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "max"]
            }
          },
          "settings": {
            "reasoningEffort": "high"
          }
        },
        "qwen-3.8-27b": {
          "name": "Qwen 3.8 27B"
        }
      }
    }
  },
  // Primary default model (replaces agents.defaults.model)
  "model": "cerebras/moonshotai-kimi-k3.1-pro-trial",
  // Lightweight model for titles/summaries (replaces utilityModel)
  "small_model": "cerebras/qwen-3.8-27b"
}
